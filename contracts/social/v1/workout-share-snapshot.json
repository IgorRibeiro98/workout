{
  "description": "O contrato do snapshot de compartilhamento de treino e de programa (T17.7 / T19.3 / T19.H2). Fixture compartilhada: lida pelo teste do Android (WorkoutShareContractTest, sobre WorkoutShareSnapshotLimits + WorkoutShareSnapshotBuilder + os DTOs que vão para a rede) e pelo teste do backend (workout-share-contract.spec.ts, sobre workout-share.validator.ts + WorkoutShareService). Os dois lados afirmam os MESMOS números e as MESMAS formas; uma mudança unilateral fica vermelha no teste de quem mudou.",
  "versions": {
    "v1": {
      "snapshotVersion": 1,
      "emptyWorkout": false,
      "customExercises": false,
      "note": "A forma original. Continua sendo escrita pelo app quando ela basta, e continua sendo aceita e importável para sempre."
    },
    "v2": {
      "snapshotVersion": 2,
      "emptyWorkout": true,
      "customExercises": true,
      "note": "Acrescenta treino vazio e exercício CUSTOM portátil. O app só a escreve quando a oferta precisa de uma das duas coisas."
    }
  },
  "limits": {
    "nameMinLength": 1,
    "nameMaxLength": 100,
    "shortIdentifierMaxLength": 10,
    "descriptionMaxLength": 500,
    "minExercisesV1": 1,
    "minExercisesV2": 0,
    "maxExercises": 30,
    "minTemplates": 1,
    "maxTemplates": 30,
    "minSortOrder": 0,
    "maxSortOrder": 30,
    "minTargetSets": 1,
    "maxTargetSets": 20,
    "minReps": 1,
    "maxReps": 100,
    "minRestSeconds": 0,
    "maxRestSeconds": 600,
    "maxOrderInProgram": 30,
    "maxCustomExercises": 30,
    "customNameMaxLength": 100,
    "customPrimaryMuscleMaxLength": 60,
    "customEquipmentMaxLength": 60,
    "customDescriptionMaxLength": 500
  },
  "canonicalExerciseIdPattern": "^[A-Za-z0-9._:-]{1,128}$",
  "customExerciseRefPattern": "^custom-[0-9]{1,3}$",
  "fields": {
    "templateSnapshot": ["snapshotVersion", "name", "shortIdentifier", "customExercises", "exercises"],
    "programSnapshot": ["snapshotVersion", "name", "description", "customExercises", "templates"],
    "programTemplate": ["name", "shortIdentifier", "orderInProgram", "scheduledDays", "dayOfWeek", "exercises"],
    "exercise": ["canonicalExerciseId", "customExerciseRef", "sortOrder", "targetSets", "minReps", "maxReps", "restDurationSeconds"],
    "customExercise": ["ref", "name", "primaryMuscle", "equipment", "description"]
  },
  "forbiddenFields": [
    "plannedWeight",
    "notes",
    "machineLabel",
    "localId",
    "syncId",
    "programId",
    "templateId",
    "ownerUid",
    "userId",
    "isCurrent",
    "externalId",
    "canonicalId",
    "customPhotoUri",
    "mediaUrl",
    "gifUrl",
    "externalExerciseId",
    "contentVersion",
    "isUserCreated",
    "origin",
    "slug"
  ],
  "rules": {
    "exerciseIdentity": "Cada exercício traz EXATAMENTE um de canonicalExerciseId (catálogo) ou customExerciseRef (V2). Os dois juntos, ou nenhum, recusam a oferta.",
    "customExerciseRefScope": "A chave só existe dentro desta oferta. Ela não é, e nunca vira, identidade global: o destinatário cria um Exercise novo, com localId e syncId dele.",
    "customExerciseRefUniqueness": "Cada ref aparece uma vez em customExercises e pode ser referenciada por N exercícios de N treinos da mesma oferta — é assim que o mesmo CUSTOM chega como uma cópia só.",
    "customExerciseRefResolution": "Todo customExerciseRef usado precisa existir em customExercises; um customExercises não referenciado por ninguém também recusa.",
    "emptyWorkout": "Em V2 um treino pode ter zero exercícios — avulso ou dentro de um programa. Um programa continua precisando de pelo menos um treino.",
    "v1Strictness": "Em V1 customExercises e customExerciseRef não existem, e exercises precisa ter de 1 a 30 itens."
  },
  "requestBody": {
    "description": "O corpo de POST /v1/social/workout-shares. Exatamente um dos dois snapshots vai preenchido — o campo presente é o discriminador do tipo.",
    "fields": ["recipientSocialId", "clientRequestId", "snapshot", "programSnapshot"],
    "snapshotVersionIsAlwaysWritten": true,
    "snapshotVersionIsAlwaysWrittenNote": "O app escrevia o corpo com kotlinx.serialization sem encodeDefaults: snapshotVersion valia 1, igual ao default da data class, e era OMITIDO do JSON. O servidor lia undefined !== 1 e recusava TODA oferta com INVALID_SNAPSHOT (T19.H2/H2.6)."
  },
