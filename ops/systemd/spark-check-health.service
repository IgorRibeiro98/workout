# Verificação operacional periódica (T16.8 §75/§83/§138).
#
# Sai com código diferente de zero quando o backend está fora, o readiness falha, o disco passa do
# limiar ou o último backup ficou velho — e é isso que faz o systemd registrar a falha e disparar
# um `OnFailure=` se você configurar um.

[Unit]
Description=Spark — verificação operacional (saúde, disco, idade do backup)
Documentation=file:///opt/spark/repo/docs/operations/RUNBOOK.md
After=docker.service

[Service]
Type=oneshot
User=spark
Group=spark
EnvironmentFile=/opt/spark/secrets/backup.env
ExecStart=/opt/spark/repo/ops/check-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
