# Backup off-site do servidor do Spark (T16.8 §41; PostgreSQL via pg_dump desde a T18.0.2).
#
# systemd timer em vez de cron por três razões concretas: `OnCalendar` com `Persistent=true`
# recupera a execução perdida enquanto a VPS estava desligada, `OnFailure=` dá um lugar honesto
# para o alerta de falha, e o log vai para o journal com o resto da máquina.
#
# Instalar:
#   sudo install -m 644 ops/systemd/spark-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now spark-backup.timer

[Unit]
Description=Spark — backup off-site do servidor (pg_dump + mídia + ledger)
Documentation=file:///opt/spark/repo/docs/operations/BACKUP_AND_RESTORE.md
# O backup fala com o Docker; sem isto ele pode rodar antes de o daemon existir no boot.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spark
Group=spark
# A configuração e as credenciais vivem fora do repositório e fora do Git.
EnvironmentFile=/opt/spark/secrets/backup.env
ExecStart=/opt/spark/repo/ops/backup.sh --tag scheduled

# Sem retry automático: um backup que falhou por credencial errada não passa a funcionar por
# insistência, e reexecutar em laço só esconde a falha do operador. O timer tenta de novo amanhã;
# `check-health.sh` acusa a idade do último sucesso hoje.
Restart=no
TimeoutStartSec=3600

# Endurecimento do serviço. O backup precisa do socket do Docker e dos diretórios do Spark — nada
# além disso.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/spark/backups /opt/spark/state /opt/spark/data

[Install]
WantedBy=multi-user.target
