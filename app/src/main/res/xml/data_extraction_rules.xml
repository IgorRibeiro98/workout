<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de backup/transferência do Android 12+ — T17.10 §106.

  Duas superfícies, e as mesmas exclusões nas duas:

  - `cloud-backup`: o backup para o Google Drive da pessoa;
  - `device-transfer`: a cópia direta aparelho a aparelho na configuração inicial.

  A `device-transfer` é a que mais importa aqui, porque é a que mais parece inofensiva: os dois
  aparelhos são da mesma pessoa. Mas o token FCM continua identificando **um** aparelho, e dois
  aparelhos anunciando o mesmo token ao backend é entrega de notificação para o lugar errado.
  Estado técnico de instalação é reconquistado no primeiro registro, nunca restaurado.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/social_push_scope.preferences_pb" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="file" path="PersistedInstallation" />
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/social_push_scope.preferences_pb" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="file" path="PersistedInstallation" />
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
    </device-transfer>
</data-extraction-rules>
