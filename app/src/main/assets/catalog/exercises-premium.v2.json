    {
      "id": "supino-reto-barra",
      "identity": {
        "namePtBr": "Supino reto com barra",
        "nameEn": "Barbell Bench Press",
        "aliases": [
          "Dumbbell Bench Press",
          "Bench Press",
          "Barbell Bench Press"
        ],
        "shortDescription": "Exercício composto focado no fortalecimento e hipertrofia de peitoral, utilizando barra com padrão biomecânico de empurrar horizontal."
      },
      "classification": {
        "difficulty": "intermediário",
        "exerciseType": "composto",
        "movementPattern": "empurrar_horizontal",
        "primaryMuscles": [
          "Peitoral"
        ],
        "secondaryMuscles": [
          "Tríceps",
          "Deltoide anterior"
        ],
        "equipment": [
          "Barra"
        ],
        "bodyRegion": "upper_body",
        "trainingGoals": [
          "hipertrofia",
          "força"
        ]
      },
      "execution": {
        "setup": {
          "title": "Posicionamento e Ajuste Inicial",
          "description": "Ajuste o equipamento (barra) e posicione o corpo de forma estável. Mantenha os pés bem apoiados, postura firme e escápulas neutras ou retraídas conforme o movimento."
        },
        "steps": [
          {
            "order": 1,
            "title": "Preparação e Ajuste",
            "description": "Ajuste o equipamento (barra) e posicione o corpo de forma estável. Mantenha os pés bem apoiados, postura firme e escápulas neutras ou retraídas conforme o movimento."
          },
          {
            "order": 2,
            "title": "Execução da Fase Concêntrica",
            "description": "Inicie o movimento focando na ativação concentrada de peitoral. Execute a fase positiva de forma controlada sem utilizar impulso ou compensação muscular."
          },
          {
            "order": 3,
            "title": "Fase Excêntrica e Retorno",
            "description": "Retorne à posição inicial controlando o peso durante toda a fase negativa. Sinta o alongamento de peitoral sem perder a tensão biomecânica."
          }
        ],
        "breathing": {
          "eccentric": "Inspire profundamente durante a fase de alongamento (excêntrica) preparando o core para a carga.",
          "concentric": "Expire de forma controlada no ponto de maior esforço (concêntrico) para estabilizar a pressão intra-abdominal."
        }
      },
      "education": {
        "tips": [
          {
            "title": "Controle do Tempo",
            "description": "Priorize 2 a 3 segundos na fase negativa (excêntrica) para otimizar o estresse mecânico e o recrutamento de fibras musculares."
          },
          {
            "title": "Estabilidade do Core",
            "description": "Mantenha a musculatura abdominal e lombar firme durante toda a amplitude para evitar compensações articulares no exercício de peitoral."
          },
          {
            "title": "Amplitude Completa",
            "description": "Execute o movimento na máxima amplitude biomecanicamente segura para obter ativação muscular completa em cada repetição."
          }
        ],
        "commonMistakes": [
          {
            "mistake": "Uso de impulso/balanço",
            "why": "Reduz drasticamente a tensão na musculatura alvo e transfere a carga para articulações vulneráveis.",
            "correction": "Reduza levemente a carga e mantenha o tronco/articulações adjacentes estáticas durante a execução."
          },
          {
            "mistake": "Amplitude incompleta ou encurtada",
            "why": "Limita os ganhos de hipertrofia ao negligenciar o alongamento sob tensão e o pico de contração.",
            "correction": "Ajuste o peso para permitir amplitude total sem perder o alinhamento corporal."
          },
          {
            "mistake": "Perda de alinhamento postural",
            "why": "Aumenta o risco de lesões na coluna ou ombros devido à perda da estabilização escapular/pélvica.",
            "correction": "Mantenha a postura neutra, escápulas ajustadas e abdominal contraído do início ao fim."
          }
        ],
        "coachNote": "Excelente escolha para desenvolver peitoral. Foque na qualidade biomecânica antes de progredir carga pesada."
      },
      "progression": {
        "method": "double_progression",
        "repRange": {
          "min": 8,
          "max": 12
        },
        "setsRecommendation": 3,
        "progressionRule": "Quando alcançar 12 repetições com boa forma técnica em todas as 3 séries, aumente a carga no menor incremento disponível (2.5kg para membros superiores / 5.0kg para inferiores).",
        "increment": {
          "upperBody": 2.5,
          "lowerBody": 5.0
        }
      },
      "safety": {
        "riskLevel": "médio",
        "attentionPoints": [
          {
            "title": "Manutenção da Postura Neutra",
            "description": "Evite flexões ou hiperextensões excessivas da coluna durante o pico de tensão da carga."
          },
          {
            "title": "Alinhamento Articular",
            "description": "Mantenha joelhos, cotovelos e punhos perfeitamente alinhados no plano anatômico do movimento."
          }
        ],
        "commonDiscomforts": [
          {
            "location": "Desconforto articular pontual",
            "possibleCause": "Carga excessiva ou erro de alinhamento anatômico",
            "adjustment": "Reduza a carga, reavalie a pegada/base dos pés e mantenha o movimento dentro da amplitude confortável."
          }
        ]
      },
