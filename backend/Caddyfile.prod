# Spark Backend — reverse proxy de produção (T16.8 §4/§5/§89).
#
#   Internet ──443──▶ Caddy (TLS Let's Encrypt) ──▶ backend:8080 (rede interna) ──▶ PostgreSQL
#
# Copiado para `Caddyfile` na VPS (`docker-compose.prod.yml` o monta somente-leitura). O domínio
# **não** está escrito aqui: `{$SPARK_DOMAIN}` vem do ambiente, porque o domínio real é
# configuração operacional e não código (§8). O mesmo arquivo versionado serve a qualquer domínio.
#
# O Caddy é quem termina o TLS e quem renova o certificado sozinho. O processo Node fala HTTP puro
# na rede interna do Compose e nunca vê certificado — é por isso que ele não emite HSTS: quem pode
# prometer algo sobre TLS é quem o termina.

{
	email {$SPARK_ACME_EMAIL}
	# Sem `auto_https off`, sem `tls internal`: produção usa certificado real. A T16.8 proíbe
	# `http://IP:8080` como endpoint de release, e este bloco é o que torna isso verdade.
}

{$SPARK_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS é responsabilidade de quem termina o TLS. Um ano, que é o mínimo para pré-carga —
		# e uma promessa que só deve ser feita quando o domínio for definitivamente HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# O proxy não anuncia o que é.
		-Server
	}

	reverse_proxy backend:8080 {
		# Repassa o request ID quando o cliente já enviou um; o backend gera um se faltar, e é ele
		# que aparece no envelope de erro — a ponte entre o relato do usuário e o log do servidor.
		header_up X-Request-Id {http.request.header.X-Request-Id}

		# Tetos de tempo coerentes com os do backend (§88). Um backup de até 4 MiB vindo de um
		# celular em rede móvel ruim não cabe em 30 s: um timeout curto aqui transformaria backup
		# legítimo em falha recorrente, e o usuário culparia o app.
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 180s
			write_timeout 180s
		}
	}

	# Teto de corpo no proxy, sempre **acima** do maior teto do backend.
	#
	# A folga é deliberada: o backend precisa **ver** o corpo grande demais para responder
	# `BACKUP_TOO_LARGE` ou `MEDIA_TOO_LARGE`, que são erros que o app entende. Se o Caddy cortasse
	# antes, o cliente receberia um 413 genérico do proxy e perderia o código — e a lógica do teto
	# passaria a viver em dois lugares que envelhecem separados (§89).
	#
	# São **dois** tetos no backend, e o proxy precisa acomodar o maior (T17.10 §93/§94):
	#
	#   JSON   (backup / sync / social)          4 MiB   — MAX_BACKUP_REQUEST_BODY_BYTES
	#   imagem (POST /v1/social/checkin-media)  10 MiB   — SOCIAL_MEDIA_MAX_UPLOAD_BYTES
	#
	# O valor era 5MB, de quando só existia o teto de JSON. Depois da T17.9 ele passou a cortar
	# foto legítima entre 5 MB e 10 MiB **antes** do backend, com um 413 genérico — o defeito
	# exato que este bloco existe para evitar, agora vindo de dentro. Elevar
	# `SOCIAL_MEDIA_MAX_UPLOAD_BYTES` no ambiente exige elevar este número junto.
	request_body {
		max_size 12MB
	}

	log {
		output stdout
		format json
		# O log do proxy também não carrega credencial: `Authorization` sai da saída. O corpo nunca
		# é registrado pelo Caddy, então backup e sync não vazam por aqui.
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
