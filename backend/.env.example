# Spark Backend — configuração de exemplo (T16.0).
#
# Este arquivo é versionado e NÃO contém segredo algum. Copie para `.env` (ignorado pelo Git) e
# ajuste localmente. A T16.0 não precisa de nenhuma credencial: não há Firebase, Gemini nem
# qualquer serviço externo neste estágio.

# development | test | production
NODE_ENV=development

# Porta HTTP. TLS é responsabilidade do Caddy à frente, não deste processo.
PORT=8080

# Obrigatório, sem default. Connection string pooled (PostgreSQL / Neon).
DATABASE_URL=postgresql://spark:spark@localhost:5432/spark_dev

# Opcional. Connection string direta para migrations e administração (Neon direct connection).
# Quando ausente, o backend utiliza DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://spark:spark@localhost:5432/spark_dev

# Pool de conexões PostgreSQL (T18.0)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Tempo máximo de drenagem em SIGTERM/SIGINT antes de encerrar à força (ms).
SHUTDOWN_TIMEOUT_MS=10000

# --- Firebase Admin (T16.1) ---------------------------------------------------------------
# Identidade do Spark vem do Firebase Auth. O backend é VERIFICADOR de token, nunca emissor:
# não há usuário/senha, JWT próprio, refresh token ou sessão do Spark.
#
# Estas duas variáveis são OPCIONAIS e não contêm segredo. Sem elas o processo sobe, /health/*
# continua público e /v1/auth/me responde 503 (incapaz de verificar) — nunca 200 sem verificação.
#
# GOOGLE_APPLICATION_CREDENTIALS é um CAMINHO para um arquivo de service account que vive fora do
# repositório e fora da imagem Docker, montado somente-leitura no container. Nunca cole aqui o
# conteúdo do JSON nem qualquer parte da chave privada.
# Ver docs/FIREBASE_AUTH_SETUP.md.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/spark-firebase-admin.json

# Projeto Firebase esperado. Normalmente já vem do arquivo de credencial; informe só se precisar
# fixá-lo explicitamente.
# FIREBASE_PROJECT_ID=

# --- Coach IA / Gemini (T16.2) --------------------------------------------------------------
# A partir da T16.2 o Android NÃO fala com o Gemini: quem fala é este backend. A credencial vive
# exclusivamente aqui — nunca no APK, no BuildConfig, em resource, em DataStore, no Git ou em
# teste.
#
# GEMINI_API_KEY é opcional: sem ela o processo sobe, o núcleo do Spark continua intacto e
# /v1/ai/coach responde 503 (AI_PROVIDER_UNAVAILABLE). Nunca cole a chave neste arquivo, que é
# versionado — coloque-a no `.env` local ou no ambiente da VPS.
# GEMINI_API_KEY=

# Modelo do Coach. O default preserva o que a T14 já usava; trocar é decisão explícita.
# GEMINI_MODEL=gemini-3.6-flash

# Teto de tempo de uma chamada ao provider (ms). Máximo 60000: a cadeia de timeout do Coach no
# Android (T18.3.1) é provider < HTTP do Coach (75 s) < absoluto (90 s), e um valor maior aqui
# faria o app publicado desistir antes de o backend legitimamente terminar de esperar o Gemini.
# AI_TIMEOUT_MS=60000

# Parâmetros de geração. Os defaults são os mesmos da T14.
# AI_TEMPERATURE=0.2
# AI_MAX_OUTPUT_TOKENS=2048
# AI_THINKING_LEVEL=MEDIUM

# Proteção de custo. A quota por conta protege o usuário; a global protege o servidor de um bug
# em vários aparelhos. Ao estourar, o Coach responde 429 e o núcleo do Spark continua normal.
# AI_MAX_REQUESTS_PER_USER_DAY=50
# AI_MAX_REQUESTS_GLOBAL_DAY=500

# Chamadas simultâneas ao provider por conta. 1 evita custo acidental e resultado fora de ordem.
# AI_MAX_CONCURRENT_REQUESTS_PER_USER=1

# --- Prontidão de produção (T16.8 / T18.0) ---------------------------------------------------
#

# Teto de tempo de uma requisição inteira. Não são 30 s de propósito: o maior corpo aceito é um
# snapshot de backup de até 4 MiB, e um celular em rede móvel ruim leva mais que isso.
# HTTP_REQUEST_TIMEOUT_MS=120000

# `keepAliveTimeout` do servidor Node. Precisa ser MAIOR que o keep-alive do proxy à frente: se o
# Node fecha primeiro, o Caddy reaproveita conexão morta e o cliente vê 502 esporádico.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# O que este deploy exige para subir. `true` transforma credencial ausente em falha de startup —
# visível — em vez de 503 em toda requisição, que parece instabilidade. Em produção,
# REQUIRE_FIREBASE_ADMIN=true é o recomendado; o default `false` preserva o comportamento das
# fases anteriores.
# REQUIRE_FIREBASE_ADMIN=false
# REQUIRE_GEMINI=false

# --- Interruptores de operação ----------------------------------------------------------------
#
# Os três respondem 503, que o Android já trata como indisponibilidade recuperável desde a T16.2:
# desligar uma capacidade no servidor não exige publicar APK novo. E nenhum deles toca o núcleo do
# Spark no aparelho — treino, execução e histórico continuam completos.
#
# Vocabulário fechado: true|false|1|0. Qualquer outro valor derruba o processo no startup.

# `false` desliga o Coach antes de quota e provider. Backup e sync continuam intactos.
# AI_ENABLED=true

# `false` pausa POST /v1/sync/push (503). O pull, somente leitura, continua. A Outbox do aparelho
# permanece pendente: é pausa, não perda.
# SYNC_WRITE_ENABLED=true

# `true` faz todo /v1 responder 503. `/health/*` continua verde de propósito — um readiness falso
# faria o Docker reiniciar o container no meio da manutenção.
# MAINTENANCE_MODE=false

# --- Notificações sociais / FCM (T17.5) -------------------------------------------------------
# Notificações sociais são estritamente auxiliares e server-authoritative (sinal best-effort).
# O núcleo social (amizades, convites, desafios) funciona mesmo com push desligado ou indisponível.
#
# Kill switch: default false (desligado até produção ser explicitamente configurada).
# SOCIAL_PUSH_ENABLED=false
#
# Intervalo de varredura do despachante em ms (default: 60000 = 1 min).
# PUSH_DISPATCH_INTERVAL_MS=60000
#
# Tentativas máximas de reenvio por falha transitória (default: 5).
# PUSH_MAX_ATTEMPTS=5
#
# Tamanho do lote de eventos a despachar por ciclo (default: 50).
# PUSH_BATCH_SIZE=50


# --- Exclusão de conta e DR (T17.6) -----------------------------------------------------------
#
# ACCOUNT_DELETION_HMAC_KEY é a chave que liga o tombstone ao Firebase UID. Ela é OBRIGATÓRIA em
# produção: com `NODE_ENV=production` e o default de desenvolvimento, o processo **não sobe**
# (`AppConfig.missingRequirements`).
#
# Duas coisas dependem dela, e as duas quebram em silêncio se ela mudar:
#
#   1. o tombstone guarda HMAC(uid) para que a tabela não revele quais contas existiram. Uma chave
#      conhecida devolve essa informação a quem tiver o banco;
#   2. trocar a chave depois de excluir contas faz **todos** os tombstones deixarem de casar:
#      contas excluídas voltam a passar pelo guard e a reconciliação de DR para de reconhecê-las.
#
# Gere uma vez, guarde no cofre e NUNCA a rotacione sem plano de migração:
#   openssl rand -hex 32
# ACCOUNT_DELETION_HMAC_KEY=

# Arquivo append-only de tombstones para Disaster Recovery. Precisa viver em volume persistente e
# entrar no backup: é ele que, depois de restaurar um snapshot antigo, diz quais contas já haviam
# sido excluídas. Sem ele, um restore ressuscita conta apagada.
#
# Desde a T17.13.1 a escrita é durável (`append` + `fsync`) e obrigatória: se ela falhar, a exclusão
# responde DELETION_PENDING — a conta já está bloqueada e os dados já foram apagados, mas a exclusão
# não é declarada concluída enquanto este registro não estiver no disco. O job fica em
# `phase = 'LEDGER_PENDING'` e o reconciliador tenta de novo.
#
# `ops/backup.sh` copia este arquivo para dentro do snapshot, e `ops/restore.sh --install` roda a
# reconciliação (`node dist/cli/reconcile-account-deletions.js`) antes de declarar a restauração
# completa. Ledger ausente ou malformado FALHA FECHADO — nunca "nenhuma conta excluída".
#
# O mesmo comando precisa da mesma ACCOUNT_DELETION_HMAC_KEY do servidor: é ela que liga um hash do
# arquivo a um uid do banco. Com a chave errada ele não encontra nada e reporta sucesso.
# DELETION_TOMBSTONES_FILE_PATH=/data/deletion_tombstones.tsv

# --- Object Storage (T18.1) --------------------------------------------------------------------
#
# Onde os BYTES vivem: as fotos dos check-ins (T17.9) e o documento canônico de cada backup
# (T16.5). O PostgreSQL continua sendo a autoridade de metadata, ownership, hashes e estado — ele
# só deixa de carregar o conteúdo pesado. A escolha do provider acontece em UM lugar
# (`src/object-storage/object-storage.factory.ts`); nenhum service, controller ou CLI decide por
# conta própria.
#
#   local  → arquivos sob SOCIAL_MEDIA_ROOT (`checkins/…` e `backups/…`). Desenvolvimento, teste
#            e CI: sem Google Cloud, sem ADC, sem rede. É o default.
#   gcs    → bucket PRIVADO do Google Cloud Storage. Produção (Cloud Run, T18.2).
#
# OBJECT_STORAGE_PROVIDER=local

# OBRIGATÓRIO com `gcs`; sem ele o processo não sobe (configuração inconsistente). Nunca há um
# bucket default no código. Vazio significa ausente.
#   spark-private-assets-prod/
#   ├── social/checkins/xx/yy/<uuid>.webp     (a chave no banco continua `checkins/…`)
#   └── backups/xx/yy/<backupId>.json
# GCS_BUCKET_NAME=spark-private-assets-prod

# NÃO EXISTE credencial GCS aqui. O SDK autentica por Application Default Credentials (ADC): no
# Cloud Run é a service account anexada ao serviço; na máquina do operador é
# `gcloud auth application-default login`. Nenhuma GCS_PRIVATE_KEY, GCS_CLIENT_EMAIL ou JSON de
# service account entra no Git, na imagem, no `.env` ou neste schema — há teste estrutural.

# Teto de UMA requisição HTTP ao bucket (ms). O retry do SDK acontece por cima, bounded.
# OBJECT_STORAGE_TIMEOUT_MS=30000

# Intervalo da coleta de objetos de backup órfãos (`backups/` sem linha no banco e mais antigos
# que a carência de 24 h). Longo de propósito: órfão é raro e cada varredura é uma listagem paga.
# BACKUP_PAYLOAD_CLEANUP_INTERVAL_MS=21600000

# --- Mídia social (T17.9) ---------------------------------------------------------------------
#
# Com OBJECT_STORAGE_PROVIDER=local, SOCIAL_MEDIA_ROOT é a raiz do armazenamento local de objetos
# (mídia em `checkins/…` — o layout de sempre — e documentos de backup em `backups/…`), e é
# OBRIGATÓRIA em produção — sem ela o processo não sobe. Precisa apontar para um volume
# persistente **separado** do banco e incluído no backup (`ops/backup.sh` manda `$SPARK_MEDIA_DIR`
# no mesmo snapshot restic). Um deploy que monte o banco e não a mídia perde todas as fotos na
# primeira recriação de container, em silêncio.
#
# Com OBJECT_STORAGE_PROVIDER=gcs ela não participa de nada e não é exigida.
# SOCIAL_MEDIA_ROOT=/data/media

# Teto de bytes de um upload (antes de decodificar). Independente do teto de JSON: o corpo de uma
# imagem e o corpo de um snapshot de backup não têm nada a ver um com o outro.
# SOCIAL_MEDIA_MAX_UPLOAD_BYTES=8388608

# Quota total por conta. É o que impede uma conta de ocupar a partição sozinha.
# SOCIAL_MEDIA_MAX_USER_BYTES=209715200

# Intervalo da varredura que recolhe mídia PENDING expirada, DELETED e órfã.
# SOCIAL_MEDIA_CLEANUP_INTERVAL_MS=900000

# --- Retenção de backup (T16.4) ---------------------------------------------------------------
# Quantos snapshots por conta o servidor mantém.
# BACKUP_RETENTION_COUNT=5

# --- Cloud Run (T18.2) --------------------------------------------------------------------------
#
# Como o Firebase Admin obtém credencial: `file` (default, GOOGLE_APPLICATION_CREDENTIALS acima)
# ou `adc` (Cloud Run — identidade da service account anexada, sem arquivo, sem variável de
# credencial). Configuração explícita, nunca detecção automática de ambiente.
# FIREBASE_ADMIN_CREDENTIAL_MODE=file

# Como as migrations do PostgreSQL se relacionam com o startup. `apply` (default) aplica as
# pendentes, como sempre. `verify` (Cloud Run API/Maintenance) nunca aplica — só confirma que o
# schema já está no nível esperado; schema pendente vira /health/ready indisponível, nunca crash.
# Quem aplica migration nesse modelo é `npm run migrate:database`, com DATABASE_URL_DIRECT, fora
# do processo da API.
# DATABASE_MIGRATION_MODE=apply

# Como os quatro workers de segundo plano (notificação, exclusão de conta, limpeza de mídia,
# limpeza de backup) iniciam. `interval` (default) agenda o próprio setInterval, como sempre —
# é o que a VPS, com processo permanente, precisa. `disabled` (Cloud Run request-based/min
# instances=0) não agenda timer nenhum; os métodos de uma passagem continuam existindo, e é isso
# que o serviço `spark-maintenance` chama a cada invocação do Cloud Scheduler.
# BACKGROUND_JOBS_MODE=interval
