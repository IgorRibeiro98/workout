{
  "name": "spark-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Spark Backend — fronteira online do Spark (T16.0: fundação).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "smoke:object-storage": "node dist/cli/object-storage-smoke.js",
    "migrate:backup-payloads": "node dist/cli/migrate-backup-payloads-to-object-storage.js",
    "migrate:social-media": "node dist/cli/migrate-social-media-to-object-storage.js",
    "reconcile:account-deletions": "node dist/cli/reconcile-account-deletions.js"
  },
  "dependencies": {
    "@google-cloud/storage": "8.1.0",
    "@google/genai": "2.21.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "firebase-admin": "14.3.0",
    "pg": "8.23.0",
    "pino": "9.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6.0.3",
    "better-sqlite3": "12.4.1",
    "eslint": "9.38.0",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
